WHATSAPP_TOKEN=EAAG...
# Meta App Dashboard -> App settings -> Basic -> App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=abc123
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
# Any random string; use the same value when registering the webhook
WHATSAPP_VERIFY_TOKEN=change-me

# Comma-separated numbers allowed to use the bot, international format without "+" (e.g. 972501234567).
# Leave empty to allow anyone (not recommended).
ALLOWED_NUMBERS=

# Firestore. Credentials come from Application Default Credentials
# (`gcloud auth application-default login` locally, automatic on Cloud Run,
# or GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json).
FIREBASE_PROJECT_ID=your-firebase-project
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

PORT=8080
TIMEZONE=Asia/Jerusalem
GRAPH_API_VERSION=v23.0
REACTION_EMOJI=✅
# The bot's own number, digits only. Invites include a wa.me link to it.
BOT_PHONE_NUMBER=972501234567
